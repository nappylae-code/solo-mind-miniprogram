/* ===== Container ===== */
.container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #FAFAFA;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 48rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ===== Logo ===== */
.app-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
}

/* ===== Title ===== */
.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #212121;
  text-align: center;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #757575;
  text-align: center;
  margin-bottom: 56rpx;
}

/* ===== 头像 + 昵称 并排 ===== */
.profile-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  margin-bottom: 48rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #E0E0E0;
  padding: 32rpx;
  box-sizing: border-box;
}

/* ===== 头像按钮 ===== */
.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  border: none;
  padding: 0;
  flex-shrink: 0;
  width: auto;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #E0E0E0;
  background-color: #F5F5F5;
  margin-bottom: 12rpx;
}

.avatar-hint {
  font-size: 22rpx;
  color: #4CAF50;
  font-weight: 500;
}

/* ===== 昵称输入框 ===== */
.nickname-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.nickname-hint {
  font-size: 22rpx;
  color: #9E9E9E;
}

.nickname-input {
  width: 100%;
  font-size: 34rpx;
  color: #212121;
  height: 60rpx;
  line-height: 60rpx;
  border-bottom: 2rpx solid #E0E0E0;
  padding-bottom: 8rpx;
}

/* ===== 进入按钮 ===== */
.btn-primary {
  background-color: #4CAF50;
  color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  width: 100%;
  box-sizing: border-box;
}

.btn-primary::after {
  border: none;
}

.btn-disabled {
  background-color: #A5D6A7 !important;
  color: #FFFFFF !important;
}